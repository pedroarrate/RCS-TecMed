<UserControl x:Class="RCSTecMed_View.RegistroSocio_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">
    
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7B1E3A" Offset="0.0"/>
                <!-- Burdeo oscuro #7B1E3A -->
                <GradientStop Color="#A52A4D" Offset="0.5"/>
                <!-- Burdeo medio #A52A4D -->
                <GradientStop Color="#D8A0A8" Offset="1.0"/>
                <!-- Burdeo claro #D8A0A8 -->
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Registro de Socios" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="White"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="White"/>
            </StackPanel>
            <Label Content="N° de Socios Registrados:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="White" Margin="1350,0,0,0"/>
            <Label x:Name="LB_TotalRegistrados" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="Yellow" 
                   Height="30" Width="100" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="1550,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Label Content="ANTECEDENTES PERSONALES" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="LightGoldenrodYellow"
                   Margin="10,0,0,0" FontStyle="Italic" Grid.Row="0"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="Transparent" Grid.Column="1"/>
                <Grid Grid.Column="1">
                    <Label Content="RUT" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,5,0,0"/>
                    <TextBox x:Name="TXT_Rut" Height="20" Width="100" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                               Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                               Margin="5,25,0,0" KeyDown="TXT_Rut_KeyDown"/>
                    <TextBox x:Name="TXT_Dv" Height="20" Width="20" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                               Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                               Margin="110,25,0,0" KeyDown="TXT_Dv_KeyDown"/>
                    <Label Content="APELLIDO PATERNO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="150,5,0,0"/>
                    <TextBox x:Name="TXT_ApellidoPaterno" Height="20" Width="300" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                               Foreground="Azure" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                               Margin="150,25,0,0" KeyDown="TXT_ApellidoPaterno_KeyDown" IsEnabled="False"/>
                    <Label Content="APELLIDO MATERNO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="470,5,0,0"/>
                    <TextBox x:Name="TXT_ApellidoMaterno" Height="20" Width="300" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="470,25,0,0" KeyDown="TXT_ApellidoMaterno_KeyDown" IsEnabled="False"/>
                    <Label Content="NOMBRES" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="790,5,0,0"/>
                    <TextBox x:Name="TXT_Nombres" Height="20" Width="300" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="790,25,0,0" KeyDown="TXT_Nombres_KeyDown" IsEnabled="False"/>
                    <Label Content="FECHA NACIMIENTO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="1110,5,0,0"/>
                    <DatePicker x:Name="DP_FechaNacimiento" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="120" FontFamily="Arial" FontSize="13" Margin="1115,25,0,0"
                                Style="{StaticResource DatePickerBordeInferiorDerechoBlanco}"/>
                    <Label Content="N° REG. SUPERINTENEDENCIA" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="Wheat" 
                           Margin="1260,5,0,0"/>
                    <TextBox x:Name="TXT_RegistroSuperintendencia" Height="20" Width="160" FontFamily="Arial" FontSize="15" FontWeight="Bold" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Wheat" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="1260,25,0,0" IsEnabled="False"/>
                    <Label Content="NACIONALIDAD" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" 
                             Margin="1440,5,0,0"/>
                    <ComboBox x:Name="CB_Nacionalidad" Height="20" Width="200" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="1440,25,0,0"/>
                    <Label Content="DOMICILIO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,60,0,0"/>
                    <TextBox x:Name="TXT_Domicilio" Height="20" Width="445" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="5,80,0,0" KeyDown="TXT_Domicilio_KeyDown"/>
                    <Label Content="REGION" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="470,60,0,0"/>
                    <ComboBox x:Name="CB_Region" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="470,80,0,0" SelectionChanged="CB_Region_SelectionChanged"/>
                    <Label Content="COMUNA" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="790,60,0,0"/>
                    <ComboBox x:Name="CB_Comuna" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="790,80,0,0"/>
                    <Label Content="EMAIL (Correo Electrónico)" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontWeight="Bold" FontSize="10" Foreground="White" Margin="1115,60,0,0"/>
                    <TextBox x:Name="TXT_EMail" Height="20" Width="525" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="1115,80,0,0" KeyDown="TXT_EMail_KeyDown"/>
                    <Label Content="TELÉFONO FIJO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,110,0,0"/>
                    <TextBox x:Name="TXT_FonoFijo" Height="20" Width="200" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="5,130,0,0" KeyDown="TXT_FonoFijo_KeyDown"/>
                    <Label Content="TELÉFONO MÓVIL" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="230,110,0,0"/>
                    <TextBox x:Name="TXT_FonoMovil" Height="20" Width="200" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="230,130,0,0" KeyDown="TXT_FonoMovil_KeyDown"/>
                    <Label Content="ESTADO DE SOCIO EN REGISTRO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="450,110,0,0"/>
                    <ComboBox x:Name="CB_EstadoSocio" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="450,130,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Label Content="ANTECEDENTES ACADÉMICOS" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="LightGoldenrodYellow"
                   Margin="10,0,0,0" FontStyle="Italic" Grid.Row="0"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="Transparent" Grid.Column="1"/>
                <Grid Grid.Column="1">
                    <Label Content="Tipo Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,5,0,0"/>
                    <ComboBox x:Name="CB_TipoCertificacion" Height="20" Width="150" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="5,25,0,0" IsEnabled="False"/>
                    <Label Content="Nombre Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="180,5,0,0"/>
                    <ComboBox x:Name="CB_NombreCertificacion" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="180,25,0,0" IsEnabled="False"/>
                    <Label Content="Fecha Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="500,5,0,0"/>
                    <DatePicker x:Name="DP_FechaCertificcion" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="120" FontFamily="Arial" FontSize="13" Margin="500,25,0,0"
                                Style="{StaticResource DatePickerBordeInferiorDerechoBlanco}"/>
                    <Label Content="Nota Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="640,5,0,0"/>
                    <TextBox x:Name="TXT_NotaCertificacion" Height="20" Width="100" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="640,25,0,0" KeyDown="TXT_NotaCertificacion_KeyDown"/>
                    <Label Content="Nota Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="760,5,0,0"/>
                    <TextBox x:Name="TXT_HorasCertificacion" Height="20" Width="100" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="760,25,0,0" KeyDown="TXT_HorasCertificacion_KeyDown"/>
                    <Label Content="Folio Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="880,5,0,0"/>
                    <TextBox x:Name="TXT_FolioCertificacion" Height="20" Width="300" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="880,25,0,0" KeyDown="TXT_FolioCertificacion_KeyDown"/>
                    <Label Content="Centro Académico" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="1190,5,0,0"/>
                    <ComboBox x:Name="CB_CentroAcademico" Height="20" Width="450" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="1190,25,0,0" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Label Content="ANTECEDENTES LABORALES" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="LightGoldenrodYellow"
                   Margin="10,0,0,0" FontStyle="Italic" Grid.Row="0"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="13"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="Transparent" Grid.Column="1"/>
                <Grid Grid.Column="1">
                    <Label Content="Región Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,5,0,0"/>
                    <ComboBox x:Name="CB_RegionLaboral" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="5,25,0,0" />
                    <Label Content="Comuna Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="330,5,0,0"/>
                    <ComboBox x:Name="CB_ComunaLaboral" Height="20" Width="300" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="330,25,0,0" />
                    <Label Content="Nombre Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="650,5,0,0"/>
                    <ComboBox x:Name="CB_EstablecimientoLaboral" Height="20" Width="990" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="650,25,0,0" />
                    <Label Content="Dirección Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,60,0,0"/>
                    <TextBox x:Name="TXT_DireccionLaboral" Height="20" Width="630" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="5,80,0,0" KeyDown="TXT_DireccionLaboral_KeyDown"/>
                    <Label Content="Teléfono Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="650,60,0,0"/>
                    <TextBox x:Name="TXT_TelefonoLaboral" Height="20" Width="200" FontFamily="Arial" FontSize="15" Style="{StaticResource WhiteTextBoxStyle}" Background="Transparent"
                             Foreground="Azure" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="650,80,0,0" KeyDown="TXT_TelefonoLaboral_KeyDown"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>
            <Label Content="FORMA DE PAGO" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="LightGoldenrodYellow"
                   Margin="10,0,0,0" FontStyle="Italic" Grid.Row="0"/>
            <Grid Grid.Row="1">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>                    
                    <ColumnDefinition Width="13"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="Transparent" Grid.Row="0"/>
                    <Label Content="Tipo Forma de Pago" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,5,0,0"/>
                    <ComboBox x:Name="CB_FormaPago" Height="20" Width="400" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="5,25,0,0" />
                    <Label Content="Fecha Aproximada de Pago" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White" Margin="5,60,0,0"/>
                    <ComboBox x:Name="CB_FechaAproxPago" Height="20" Width="800" FontFamily="Arial" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center" Margin="5,80,0,0" />
                </Grid>
                <Border CornerRadius="10" BorderBrush="White" BorderThickness="2" Background="Transparent" Grid.Column="3"/>
                <Grid Grid.Column="3">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <StackPanel>
                            <Label Content="COMPLETAR DATOS DE LLAMADA" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" FontWeight="Black"
                                   Foreground="Yellow" Margin="0,5,0,0"/>
                            <TextBlock Text="Importante: Si falta algún dato en menús de seleccion debe Completar Datos de llamada, presione el boton COMPLETAR DATOS DE LLAMADA para ingresar datos faltante y continuar con wl proceso de Registro de Socio" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="White" Width="370" Height="100" 
                                       TextWrapping="Wrap" TextAlignment="Justify" Margin="0,2,0,0"/>
                        </StackPanel>                        
                    </Grid>
                    <Grid Grid.Column="1">
                        <Button x:Name="BTN_CompletarDatos" Width="200" Height="80" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_CompletarDatos_Click" Grid.Column="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconImage Icon="FilePen" Width="30" Height="30" Margin="0,0,8,0"/>
                                <TextBlock Text="Completar&#x0a;Datos de&#x0a;Llamada" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BTN_Buscar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Buscar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Search" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Buscar&#x0a;Socio" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Grabar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Grabar_Click" Grid.Column="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Save" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar&#x0a;Socio" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Actualizar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Actualizar_Click" Grid.Column="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="ArrowRotateForward" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualizar&#x0a;Socio" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Eliminar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Eliminar_Click" Grid.Column="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="TrashAlt" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Eliminar&#x0a;Socio" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="DesktopAlt" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Limpiar&#x0a;Pantalla" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>
