<Window x:Class="RCSTecMed_View.View_ConfirmaEliminar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RCSTecMed_View"
        mc:Ignorable="d"
        Title="RCS-TecMed -Confirma Eliminar" Height="350" Width="700"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B1E3A" Offset="0.0"/>
            <!-- Burdeo oscuro -->
            <GradientStop Color="#A52A4D" Offset="0.5"/>
            <!-- Burdeo medio -->
            <GradientStop Color="#D8A0A8" Offset="1.0"/>
            <!-- Burdeo claro -->
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Label Content="Confirmar Eliminación de Registro" FontFamily="Arial" FontSize="25" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Ingrese su Contraseña" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White"
                       Margin="0,10,0,0" Grid.Column="0"/>
                <PasswordBox x:Name="PB_Contraseña1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BurdeoPasswordBoxWhiteStyle}" Height="30" 
                             Width="300" Background="Transparent" Foreground="Yellow" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="PB_Contraseña1_KeyDown" Grid.Column="0"/>
                <Label Content="Confirme su Contraseña" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Foreground="White"
                             Margin="0,10,0,0" Grid.Column="1"/>
                <PasswordBox x:Name="PB_Contraseña2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BurdeoPasswordBoxWhiteStyle}" Height="30" 
                             Width="300" Background="Transparent" Foreground="Yellow" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="PB_Contraseña2_KeyDown" Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="1">
                <Button x:Name="BTN_ConfirmaEliminar" Style="{StaticResource BotonEstilo1}" Width="150" Height="40" Click="BTN_ConfirmaEliminar_Click" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconImage Icon="TrashCan" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Eliminar Registro" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Image Source="/Imagenes/logo-tecmed.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Window>
