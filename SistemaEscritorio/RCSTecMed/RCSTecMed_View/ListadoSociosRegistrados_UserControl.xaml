<UserControl x:Class="RCSTecMed_View.ListadoSociosRegistrados_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7B1E3A" Offset="0.0"/>
                <!-- Burdeo oscuro #7B1E3A -->
                <GradientStop Color="#A52A4D" Offset="0.5"/>
                <!-- Burdeo medio #A52A4D -->
                <GradientStop Color="#D8A0A8" Offset="1.0"/>
                <!-- Burdeo claro #D8A0A8 -->
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>            
            <RowDefinition Height="5"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Informes de Socios Registrados" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="White"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="White"/>
            </StackPanel>
            <Label Content="N° de E.L. Registrados:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" Margin="1340,0,0,0"/>
            <Label x:Name="LB_TotalRegistrados" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" 
                   Height="30" Width="100" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="1500,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Label Content="Seleccione Región a Mostrar" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" FontWeight="Bold" Foreground="White" Margin="20,0,0,0"/>
            <ComboBox x:Name="CB_Region" Height="30" Width="500" FontFamily="Arial" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" 
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="250,0,0,0" />
            
            <Button x:Name="BTN_Mostrar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Mostrar_Click" 
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="800,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileLines" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Mostrar&#x0a;Datos" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Reporte" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Reporte_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1050,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileCsv" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Generar&#x0a;Reporte" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="3">
            <DataGrid x:Name="DG_Reporte" FontFamily="Arial" FontSize="20" FontWeight="Bold" Background="White" ColumnHeaderHeight="30" AutoGenerateColumns="False" 
                      IsReadOnly="True" Width="1600" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Registro" Binding="{Binding FolioRegistro}" FontWeight="Light" Width="130"/>
                    <DataGridTextColumn Header="Rut" Binding="{Binding Rut}" FontWeight="Light" Width="130"/>
                    <DataGridTextColumn Header="Dv" Binding="{Binding Dv}" FontWeight="Light" Width="40"/>
                    <DataGridTextColumn Header="Apellido Paterno" Binding="{Binding ApellidoPaterno}" FontWeight="Light" Width="200"/>
                    <DataGridTextColumn Header="Apellido Materno" Binding="{Binding ApellidoMaterno}" FontWeight="Light" Width="200"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombres}" FontWeight="Light" Width="200"/>
                    <DataGridTextColumn Header="Comuna/Región Residencia" Binding="{Binding _nombreComunaRegion}" FontWeight="Light" Width="500"/>
                    <DataGridTextColumn Header="Establecimiento Actual" Binding="{Binding _nombreEstablecimiento}" FontWeight="Light" Width="500"/>
                    <DataGridTextColumn Header="Comuna/Región Laboral" Binding="{Binding _nombreComunaRegionLaboral}" FontWeight="Light" Width="500"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding _descripcionEstadoSocio}" FontWeight="Light" Width="300"/>
                    <DataGridTextColumn Header="Fecha Registro" Binding="{Binding FechaRegistroMostrar}" FontWeight="Light" Width="300"/>
                    <DataGridTextColumn Header="Registrado Por" Binding="{Binding _nombreUsuario}" FontWeight="Light" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Desktop" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Limpiar&#x0a;Pantalla" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>
