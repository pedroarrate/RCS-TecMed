<UserControl x:Class="RCSTecMed_View.ActualizaEstabelcimientoActual_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">
    <Grid Background="#cdb0b5">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Ingreso de Recinto Laboral Actual" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="Black"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Black"/>
            </StackPanel>
            <Label Content="N° de E.L. Registrados:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" Margin="1340,0,0,0"/>
            <Label x:Name="LB_TotalRegistrados" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" 
                   Height="30" Width="100" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="1500,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Label Content="Rut Socio" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" FontWeight="DemiBold" Margin="20,0,0,0"/>
                    <TextBox x:Name="TXT_Rut" Height="20" Width="80" FontFamily="Arial" FontSize="15" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                             Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" 
                             Margin="110,0,0,0" KeyDown="TXT_Rut_KeyDown"/>
                    <TextBox x:Name="TXT_Dv" Height="20" Width="20" FontFamily="Arial" FontSize="15" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                             Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" 
                             Margin="195,0,0,0" KeyDown="TXT_Dv_KeyDown"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Button x:Name="BTN_Buscar" Width="100" Height="35" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" 
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="BTN_Buscar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconImage Icon="Search" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label Content="Establecimientos Registrados por Socio" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Brown"/>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="DG_Laborales" FontFamily="Arial" FontSize="20" FontWeight="Bold" Background="White" ColumnHeaderHeight="30" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionChanged="DG_Laborales_SelectionChanged" Width="1600" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Registro" Binding="{Binding IdEstablecimientoActual}" FontWeight="Light" Width="130"/>
                            <DataGridTextColumn Header="Nombre Socio" Binding="{Binding _nombreSocio}" FontWeight="Light" Width="400"/>
                            <DataGridTextColumn Header="Establecimiento Actual" Binding="{Binding _nombreEstablecimiento}" FontWeight="Light" Width="500"/>
                            <DataGridTextColumn Header="Desde" Binding="{Binding FechaEstablecimientoActualDesde}" FontWeight="Light" Width="150"/>
                            <DataGridTextColumn Header="Hasta" Binding="{Binding FechaEstablecimientoActualHasta}" FontWeight="Light" Width="150"/>
                            <DataGridTextColumn Header="Registrado Por" Binding="{Binding _nombreUsuario}" FontWeight="Light" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="Gray" BorderThickness="2" Background="Transparent" Grid.Column="1"/>
                <Border CornerRadius="10" BorderBrush="Gray" BorderThickness="2" Background="Transparent" Grid.Column="3"/>
                <Grid Grid.Column="1">
                    <Label Content="Datos de Socio Seleccionado" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Chocolate"/>
                    <Label Content="N° Registro" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,30,0,0"/>
                    <Label x:Name="LB_Registro" Height="35" Width="150" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,50,0,0"/>
                    <Label Content="Nombre Socio" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="160,30,0,0"/>
                    <Label x:Name="LB_Socio" Height="35" Width="450" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="160,50,0,0"/>
                    <Label Content="Nombre Establecimiento" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,90,0,0"/>
                    <Label x:Name="LB_Establecimiento" Height="35" Width="750" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,110,0,0"/>
                    <Label Content="Comuna" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,150,0,0"/>
                    <Label x:Name="LB_Comuna" Height="35" Width="350" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,170,0,0"/>
                    <Label Content="Región" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="370,150,0,0"/>
                    <Label x:Name="LB_Region" Height="35" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="370,170,0,0"/>
                    <Label Content="A Contar de" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,210,0,0"/>
                    <Label x:Name="LB_FechaDesde" Height="35" Width="350" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,220,0,0"/>
                    <Label Content="Hasta" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="370,210,0,0"/>
                    <Label x:Name="LB_FechaHasta" Height="35" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="370,220,0,0"/>
                </Grid>
                <Grid Grid.Column="3">
                    <Label Content="Nuevo Registro de Establecimiento Laboral" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Blue"/>
                    <Label Content="Region Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,30,0,0"/>
                    <ComboBox x:Name="CB_Region" Height="20" Width="300" FontFamily="Arial" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,50,0,0" SelectionChanged="CB_Region_SelectionChanged"/>
                    <Label Content="Comuna Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="370,30,0,0"/>
                    <ComboBox x:Name="CB_Comuna" Height="20" Width="300" FontFamily="Arial" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="370,50,0,0" SelectionChanged="CB_Comuna_SelectionChanged"/>
                    <Label Content="Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,90,0,0"/>
                    <ComboBox x:Name="CB_Establecimiento" Height="20" Width="750" FontFamily="Arial" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5,110,0,0" SelectionChanged="CB_Establecimiento_SelectionChanged"/>
                    <Label Content="A Contar de" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="5,150,0,0"/>
                    <DatePicker x:Name="DP_FechaInicial" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="120" FontFamily="Arial" FontSize="13" 
                                Margin="5,170,0,0" Style="{StaticResource DatePickerBordeInferiorDerechoBlanco}" SelectedDateChanged="DP_FechaInicial_SelectedDateChanged" />

                    <Button x:Name="BTN_Grabar" Width="200" Height="75" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Grabar_Click" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,160,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconImage Icon="Save" Width="40" Height="40" Margin="0,0,8,0"/>
                            <TextBlock Text="Registrar&#x0a;Nuevo&#x0a;Establecimiento" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileEdit" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Ingresar&#x0a;Otro" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>
        </Grid>
</Grid>
</UserControl>
