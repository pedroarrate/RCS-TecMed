<Window x:Class="RCSTecMed_View.View_CompletarDatosRegistroSocio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RCSTecMed_View"
        mc:Ignorable="d"
        Title="RCS-TecMed - Completar Datos de Registro Socios" Height="1000" Width="1900"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Image Source="/Imagenes/logo-tecmed.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="RCS-TecMed" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="#641c34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Label Content="Herramientas Completitud de Registros" FontFamily="Arial" FontSize="40" FontWeight="Black" Foreground="#641c34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Label Content="Fecha: " HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" FontWeight="Bold" Margin="10,20,0,0"/>
                <Label x:Name="LB_Fecha" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" Margin="150,20,0,0"/>
                <Label Content="Hora Conexión:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" FontWeight="Bold" Margin="10,50,0,0"/>
                <Label x:Name="LB_HoraConexion" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" Margin="150,50,0,0"/>
                <Label Content="Usuario:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" FontWeight="Bold" Margin="10,80,0,0"/>
                <Label x:Name="LB_Usuario" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" Margin="150,80,0,0"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TabControl x:Name="MainTabControl" TabStripPlacement="Left" Margin="10" FontFamily="Arial" FontSize="16" BorderBrush="#641c34" BorderThickness="2" Background="White" SelectedIndex="0" 
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" CornerRadius="6" BorderThickness="1" BorderBrush="#641c34" Background="Transparent" Margin="4" Padding="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Ícono opcional -->
                                                <TextBlock Text="🏛" FontSize="16" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                <ContentPresenter ContentSource="Header" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="Blue"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="BlueViolet"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <!-- HOME (oculta encabezado) -->
                    <TabItem x:Name="TAB_Home" Header="" Visibility="Collapsed">
                        <Grid Background="White">
                            <Image Source="/Imagenes/Tool_TecMed1.png"  Stretch="Fill"/>
                            <Label Content="Bienvenido a Herramientas de Completitud de Registros" FontSize="24" FontWeight="Bold" Foreground="#641c34" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Grid>
                    </TabItem>
                    <!-- Registro de Centro Academico -->
                    <TabItem x:Name="TAB_CentroAcademico" Header="Centro Academico"/>
                    <!-- Registro de Tipo Certificacion -->
                    <TabItem x:Name="TAB_TipoCertificacion" Header="Tipo de Certificación"/>
                    <!-- Registro de Establecimiento Laboral -->
                    <TabItem x:Name="TAB_EstablecimientoLaboral" Header="Establecimiento Laboral"/>
                    <!-- Registro de Forma de Pago -->
                    <TabItem x:Name="TAB_FormaPago" Header="Forma de Pago"/>
                    <!-- Registro de Estimado de Pago -->
                    <TabItem x:Name="TAB_EstimadoPago" Header="Fecha Estimada de Pago"/>
                    <!-- Salir -->
                    <TabItem x:Name="TAB_Salir" Header="Volver"/>

                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
