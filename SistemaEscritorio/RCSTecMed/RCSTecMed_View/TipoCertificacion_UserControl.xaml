<UserControl x:Class="RCSTecMed_View.TipoCertificacion_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">
    <Grid Background="#cdb0b5">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Registro de Tipos de Certificación" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="Black"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Black"/>
            </StackPanel>
            <Label Content="N° de T.C. Registrados:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" Margin="1340,0,0,0"/>
            <Label x:Name="LB_TotalRegistrados" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" 
                   Height="30" Width="100" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="1500,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Label Content="N° Registro Tipo Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="30" FontWeight="DemiBold" Margin="220,100,0,0"/>
            <TextBox x:Name="TXT_IdTipoCertificacion" Height="30" Width="300" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                               Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                               Margin="700,110,0,0" KeyDown="TXT_IdTipoCertificacion_KeyDown"/>
            <Label Content="Descripción Tipo Certificación" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="30" FontWeight="DemiBold" Margin="220,200,0,0"/>
            <TextBox x:Name="TXT_TipoCertificacion" Height="30" Width="670" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                   Foreground="Black" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="700,210,0,0" KeyDown="TXT_TipoCertificacion_KeyDown"/>
            

            <DataGrid x:Name="DG_TipoCertificacion" FontFamily="Arial" FontSize="20" FontWeight="Bold" Background="White" ColumnHeaderHeight="30" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionChanged="DG_TipoCertificacion_SelectionChanged" Width="1600" Height="280" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Registro" Binding="{Binding IdCertificacion}" FontWeight="Light" Width="200"/>
                    <DataGridTextColumn Header="Descripción Tipo Certificación" Binding="{Binding DescripcionCertificacion}" FontWeight="Light" Width="*"/>
                    <DataGridTextColumn Header="Registrado Por" Binding="{Binding UsuarioNombre}" FontWeight="Light" Width="400"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BTN_Buscar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Buscar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Search" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Grabar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Grabar_Click" Grid.Column="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Save" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Actualizar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Actualizar_Click" Grid.Column="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="ArrowRotateForward" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Eliminar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Eliminar_Click" Grid.Column="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="TrashAlt" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileEdit" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Ingresar&#x0a;Otro" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

        </Grid>

    </Grid>
</UserControl>
