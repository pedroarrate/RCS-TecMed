<UserControl x:Class="RCSTecMed_View.Certificaciones_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">
    <Grid Background="#cdb0b5">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Registro de Certificaciones" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="Black"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Black"/>
            </StackPanel>            
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Label Content="Rut Socio" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" FontWeight="DemiBold" Margin="20,0,0,0"/>
                    <TextBox x:Name="TXT_Rut" Height="20" Width="80" FontFamily="Arial" FontSize="15" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                             Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" 
                             Margin="110,0,0,0" KeyDown="TXT_Rut_KeyDown"/>
                    <TextBox x:Name="TXT_Dv" Height="20" Width="20" FontFamily="Arial" FontSize="15" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                             Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" 
                             Margin="195,0,0,0" KeyDown="TXT_Dv_KeyDown"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Button x:Name="BTN_Buscar" Width="100" Height="35" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" 
                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="BTN_Buscar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconImage Icon="Search" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Label Content="Certificaciones Efectuadas en ColTecMed" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Brown"/>
                </Grid>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="DG_Certificaciones" FontFamily="Arial" FontSize="20" FontWeight="Bold" Background="White" ColumnHeaderHeight="30" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionChanged="DG_Certificaciones_SelectionChanged" Width="1600" Height="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Registro" Binding="{Binding IdAcademcico}" FontWeight="Light" Width="130"/>
                            <DataGridTextColumn Header="Nombre Socio" Binding="{Binding _nombresocio}" FontWeight="Light" Width="400"/>
                            <DataGridTextColumn Header="Certificación Realizada" Binding="{Binding _descCertificacion}" FontWeight="Light" Width="500"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaRegistro}" FontWeight="Light" Width="100"/>
                            <DataGridTextColumn Header="Nota" Binding="{Binding Nota}" FontWeight="Light" Width="100"/>
                            <DataGridTextColumn Header="Horas" Binding="{Binding Horas}" FontWeight="Light" Width="100"/>
                            <DataGridTextColumn Header="Registrado Por" Binding="{Binding _nombreUsuario}" FontWeight="Light" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
               
            </Grid>
            <Grid Grid.Row="2">
                <Label Content="Nombre Socio" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="20,10,0,0"/>
                <Label x:Name="LB_NombreSocio" Height="35" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                           HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="20,30,0,0"/>
                <Label Content="Fecha Curso" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="600,10,0,0"/>
                <DatePicker x:Name="DP_FechaCurso" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="120" FontFamily="Arial" FontSize="13" 
                            Margin="600,30,0,0" Style="{StaticResource DatePickerBordeInferiorDerechoBlanco}" />
                <Label Content="Nota" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="20,80,0,0"/>
                <Label Content="Nombre Curso" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="800,10,0,0"/>
                <ComboBox x:Name="CB_Curso" Height="30" Width="820" FontFamily="Arial" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" 
                              HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="800,30,0,0" />
                <TextBox x:Name="TXT_Nota" Height="30" Width="100" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                         Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                         Margin="20,100,0,0" KeyDown="TXT_Nota_KeyDown"/>
                <Label Content="Horas" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="200,80,0,0"/>
                <TextBox x:Name="TXT_Horas" Height="30" Width="100" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                         Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                         Margin="200,100,0,0" KeyDown="TXT_Horas_KeyDown"/>
                <Label Content="Folio Registro" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="10" FontWeight="Bold" Margin="380,80,0,0"/>
                <Label x:Name="LB_FolioRegistro" Height="35" Width="700" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="20" 
                       HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="380,100,0,0"/>
            </Grid>            
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BTN_Grabar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Grabar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Save" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Generar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Generar_Click" Grid.Column="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FilePdf" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Generar&#x0a;Certificado" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Imprimir" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Imprimir_Click" Grid.Column="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Print" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Imprimir&#x0a;Certificado" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Enviar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Enviar_Click" Grid.Column="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="MailBulk" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Enviar por&#x0a;EMail" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>
            
            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileEdit" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Ingresar&#x0a;Otro" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</UserControl>
