<UserControl x:Class="RCSTecMed_View.EstablecimientoLaboral_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RCSTecMed_View"
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="1700">
    <Grid Background="#cdb0b5">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Registro de Establecimientos Laborales" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="30" FontWeight="Black" Foreground="Black"/>
                <Label Content="Colegio de Tecnólogos Médicos de Chile" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="20" FontWeight="Black" Foreground="Black"/>
            </StackPanel>
            <Label Content="N° de E.L. Registrados:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" Margin="1340,0,0,0"/>
            <Label x:Name="LB_TotalRegistrados" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="15" Foreground="WhiteSmoke" 
                   Height="30" Width="100" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="1500,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Label Content="N° Registro Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="50,30,0,0"/>
            <TextBox x:Name="TXT_IdEstablecimiento" Height="30" Width="330" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="50,60,0,0" KeyDown="TXT_IdEstablecimiento_KeyDown"/>
            <Label Content="Nombre Establecimiento Laboral" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="500,30,0,0"/>
            <TextBox x:Name="TXT_NombreEstablecimiento" Height="30" Width="1100" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="500,60,0,0" KeyDown="TXT_NombreEstablecimiento_KeyDown"/>
            <Label Content="Región Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="50,110,0,0"/>
            <ComboBox x:Name="CB_Region" Height="30" Width="350" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Center" Margin="50,140,0,0" SelectionChanged="CB_Region_SelectionChanged"/>
            <Label Content="Comuna Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="420,110,0,0"/>
            <ComboBox x:Name="CB_Comuna" Height="30" Width="330" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="15" HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Center" Margin="420,140,0,0"/>
            <Label Content="Dirección Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="770,110,0,0"/>
            <TextBox x:Name="TXT_Direccion" Height="30" Width="830" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="770,140,0,0" KeyDown="TXT_Direccion_KeyDown"/>
            <Label Content="Teléfono" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="50,200,0,0"/>
            <TextBox x:Name="TXT_Telefono" Height="30" Width="200" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="50,230,0,0" KeyDown="TXT_Telefono_KeyDown"/>
            <Label Content="Email Establecimiento Laboral" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="270,200,0,0"/>
            <TextBox x:Name="TXT_Email" Height="30" Width="800" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="270,230,0,0" KeyDown="TXT_Email_KeyDown"/>
            <Label Content="Nombre Contacto" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Arial" FontSize="18" FontWeight="DemiBold" Margin="1090,200,0,0"/>
            <TextBox x:Name="TXT_Contacto" Height="30" Width="510" FontFamily="Arial" FontSize="20" Style="{StaticResource  BurdeoTextBoxStyle}" Background="Transparent"
                     Foreground="Black" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="1090,230,0,0" KeyDown="TXT_Contacto_KeyDown"/>
            <DataGrid x:Name="DG_Establecimiento" FontFamily="Arial" FontSize="20" FontWeight="Bold" Background="White" ColumnHeaderHeight="30" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionChanged="DG_Establecimiento_SelectionChanged" Width="1600" Height="280" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,10" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Registro" Binding="{Binding IdEstablecimiento}" FontWeight="Light" Width="200"/>
                    <DataGridTextColumn Header="Nombre Establecimiento" Binding="{Binding NombreEstablecimiento}" FontWeight="Light" Width="600"/>
                    <DataGridTextColumn Header="Región" Binding="{Binding _nombreRegion}" FontWeight="Light" Width="400"/>
                    <DataGridTextColumn Header="Registrado Por" Binding="{Binding _nombreUsuario}" FontWeight="Light" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BTN_Buscar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Buscar_Click" Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Search" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Grabar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Grabar_Click" Grid.Column="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Save" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Registrar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Actualizar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Actualizar_Click" Grid.Column="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="ArrowRotateForward" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Eliminar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Eliminar_Click" Grid.Column="7">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="TrashAlt" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Eliminar" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Limpiar" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Limpiar_Click" Grid.Column="9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="FileEdit" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Ingresar&#x0a;Otro" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="BTN_Home" Width="200" Height="45" Background="#FFDDDDDD" Style="{StaticResource BotonEstilo1}" Click="BTN_Home_Click" Grid.Column="11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="Home" Width="25" Height="25" Margin="0,0,8,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"/>
                </StackPanel>
            </Button>

        </Grid>

    </Grid>
</UserControl>
